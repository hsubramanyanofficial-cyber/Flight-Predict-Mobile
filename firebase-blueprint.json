{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "TrackedRoute": {
      "title": "TrackedRoute",
      "description": "User tracked flight routes for price drop alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "origin": { "type": "string", "maxLength": 3, "minLength": 3 },
        "destination": { "type": "string", "maxLength": 3, "minLength": 3 },
        "targetPrice": { "type": "number" },
        "cabinClass": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "origin", "destination", "targetPrice"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat messages with Gemini assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string", "maxLength": 4096 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "role", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/trackedRoutes/{routeId}": {
      "schema": "TrackedRoute",
      "description": "Tracked flight routes for user"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "User chat history with AI"
    }
  }
}
